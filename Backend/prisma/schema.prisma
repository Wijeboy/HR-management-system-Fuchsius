generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

model User {
  id           String   @id @map("_id")
  employeeId   String   @unique
  name         String
  email        String   @unique
  password     String
  role         String
  department   String
  jobTitle     String?
  phone        String?
  location     String?
  profileImage String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([department])
}

model AttendanceRecord {
  id           String   @id @map("_id")
  employeeId   String
  employeeName String
  department   String
  date         String
  checkIn      String?
  checkOut     String?
  totalHours   Float    @default(0)
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

model LeaveBalance {
  id           String   @id @map("_id")
  employeeId   String
  year         Int
  medical      Int      @default(12)
  vacation     Int      @default(18)
  medicalUsed  Int      @default(0)
  vacationUsed Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, year])
}

model LeaveRequest {
  id                 String   @id @map("_id")
  employeeId         String
  employeeName       String
  department         String
  leaveType          String
  startDate          String
  endDate            String?
  durationDays       Int
  reason             String
  status             String
  supportingDocument String?
  documentMimeType   String?
  reviewedBy         String?
  reviewedAt         String?
  hrComment          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id            String   @id @map("_id")
  recipientId   String
  recipientRole String
  message       String
  type          String
  relatedLeaveId String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([recipientId])
  @@index([read])
}

model PayrollEmployee {
  id             String          @id @map("_id")
  name           String
  department     String
  baseSalary     Float
  fixedAllowance Float
  paymentMethod  String
  bankName       String
  accountNo      String
  payrollRecords PayrollRecord[]
}

model PayrollRecord {
  id             String          @id @map("_id")
  employeeId     String
  employeeName   String
  department     String
  period         String
  attendanceDays Int
  leaveDays      Int
  gross          Float
  deductions     Float
  net            Float
  status         String
  paymentDate    String
  employee       PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([period])
}

model Payslip {
  id              String            @id @map("_id")
  payrollId       String
  employeeId      String
  employeeName    String
  department      String
  period          String
  periodLabel     String
  paymentDate     String
  paymentMethod   String
  bankName        String
  accountNo       String
  earnings        PayslipLineItem[]
  deductions      PayslipLineItem[]
  gross           Float
  totalDeductions Float
  net             Float
  attendanceDays  Int
  leaveDays       Int

  @@index([employeeId, period])
}

type PayslipLineItem {
  label  String
  amount Float
}

model PerformanceReview {
  id              String @id @map("_id")
  employeeName    String
  employeeId      String
  department      String
  reviewer        String
  cycle           String
  goalsScore      Float
  competencyScore Float
  behaviorScore   Float
  finalRating     Float
  recommendation  String
  status          String

  @@index([employeeId])
  @@index([cycle])
  @@index([status])
}

model PerformanceGoal {
  id            String  @id @map("_id")
  employeeName  String
  employeeId    String
  goal          String
  metric        String
  target        Float
  current       Float
  weight        Float
  dueDate       String
  lowerIsBetter Boolean

  @@index([employeeId])
}

